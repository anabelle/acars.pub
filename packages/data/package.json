{
  "name": "@acars/data",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./airports": {
      "types": "./dist/airports.d.ts",
      "default": "./dist/airports.js"
    }
  },
  "scripts": {
