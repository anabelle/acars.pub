  },
  "dependencies": {
    "@acars/core": "workspace:*"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "typescript": "^7.0.2",
    "tz-lookup": "6.1.25",
    "vitest": "^5.0.1"
  }
