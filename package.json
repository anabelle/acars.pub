{
  "name": "acars",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source decentralized airline management game on Nostr",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @acars/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test -- --run",
    "test:coverage": "pnpm -r test -- --run --coverage.enabled --coverage.thresholds.autoUpdate=false",
    "test:e2e": "pnpm --filter @acars/web test:e2e",
    "balance": "pnpm --filter @acars/store balance",
    "funnel": "node --experimental-strip-types --no-warnings scripts/funnel.ts",
    "screenshots": "pnpm --filter @acars/web screenshots:e2e",
    "typecheck:functions": "tsc -p functions --noEmit",
    "verify:contracts": "pnpm -r build && pnpm -r typecheck",
    "verify:boundaries": "pnpm -r lint",
    "verify:determinism": "pnpm --filter @acars/core test -- --run",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,scss,html}": [
      "bash -lc 'for f in \"$@\"; do if [ \"$f\" != \"packages/data/src/airports.ts\" ]; then printf \"%s\\n\" \"$f\"; fi; done | xargs -r biome format --write' --"
    ],
    "**/*.{md,mdx,yml,yaml}": [
      "prettier --write"
    ],
    "**/*.{ts,tsx,js,jsx,cjs,mjs}": [
      "bash -lc 'for f in \"$@\"; do if [ \"$f\" != \"packages/data/src/airports.ts\" ]; then printf \"%s\\n\" \"$f\"; fi; done | xargs -r eslint' --"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "pnpm": {
    "overrides": {
      "tsx>esbuild": ">=0.28.1",
      "apache-arrow>@types/node": "^24.13.4"
    },
    "patchedDependencies": {
      "tseep@1.3.1": "patches/tseep@1.3.1.patch"
    }
  }
}
