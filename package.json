{
  "name": "acars",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source decentralized airline management game on Nostr",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @acars/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test -- --run",
    "test:coverage": "pnpm -r test -- --run --coverage.enabled --coverage.thresholds.autoUpdate=false",
    "typecheck:functions": "tsc -p functions --noEmit",
    "verify:contracts": "pnpm -r build && pnpm -r typecheck",
    "verify:boundaries": "pnpm -r lint",
    "verify:determinism": "pnpm --filter @acars/core test -- --run",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,mjs,json,css,scss,html}": [
      "bash -lc 'for f in \"$@\"; do if [ \"$f\" != \"packages/data/src/airports.ts\" ]; then printf \"%s\\n\" \"$f\"; fi; done | xargs -r biome format --write' --"
    ],
    "**/*.{md,mdx,yml,yaml}": [
      "prettier --write"
    ],
    "**/*.{ts,tsx,js,jsx,cjs,mjs}": [
      "bash -lc 'for f in \"$@\"; do if [ \"$f\" != \"packages/data/src/airports.ts\" ]; then printf \"%s\\n\" \"$f\"; fi; done | xargs -r eslint' --"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "pnpm": {
    "overrides": {
      "tsx>esbuild": ">=0.28.1"
    },
    "patchedDependencies": {
      "tseep@1.3.1": "patches/tseep@1.3.1.patch"
    }
  }
}
