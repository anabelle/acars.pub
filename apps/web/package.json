{
  "name": "@acars/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint src server vite.config.ts capacitor.config.ts eslint.config.js tailwind.config.js postcss.config.js e2e playwright.config.ts",
    "preview": "vite preview",
    "screenshots": "node ./scripts/capture-responsive-screenshots.mjs",
    "screenshots:e2e": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@acars/core": "workspace:*",
    "@acars/data": "workspace:*",
    "@acars/map": "workspace:*",
    "@acars/nostr": "workspace:^",
    "@acars/store": "workspace:*",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/b612": "5.3.0",
    "@fontsource/b612-mono": "5.3.0",
    "@fontsource/overpass": "5.3.0",
    "@nostr-dev-kit/ndk": "3.0.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-virtual": "^3.14.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.5",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^6.14.0",
    "nostr-tools": "^2.25.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.5.6",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
